const sequenciaEntradas = [5, 2, 1, 3];
let indiceEntrada = 0;
 
let opcao: number;
do {
  console.log("Menu: 1 - Cadastrar | 2 - Consultar | 3 - Sair");
 
  opcao = sequenciaEntradas[indiceEntrada];
  indiceEntrada++;
 
  if (opcao === 1) {
    console.log("Executando: Cadastrar");
  } else if (opcao === 2) {
    console.log("Executando: Consultar");
  } else if (opcao === 3) {
    console.log("Encerrando o programa");
  } else {
    console.log(`Opção inválida: ${opcao}. Exibindo o menu novamente.`);
  }
} while (opcao !== 3);
 
