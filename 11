const consumoSemanal: number[] = [92, 110, 147, 83, 130, 75, 160];
 
let total = 0;
for (const consumo of consumoSemanal) {
  total += consumo;
}
 
const media = total / consumoSemanal.length;
 
let diasAcimaDaMedia = 0;
for (const consumo of consumoSemanal) {
  if (consumo > media) {
    diasAcimaDaMedia++;
  }
}
 
console.log(`Total da semana: ${total} kWh`);
console.log(`Média diária: ${media.toFixed(2)} kWh`);
console.log(`Dias acima da média: ${diasAcimaDaMedia}`);
