function arredondar(valor: number): number {
  return Math.round(valor * 100) / 100;
}
 
function simularPagamento(saldoInicial: number, pagamentoMensal: number): void {
  let saldo = arredondar(saldoInicial);
  let mes = 0;
  const LIMITE_MESES = 120;
  const TAXA_JUROS = 0.01;
 
  while (saldo > 0 && mes < LIMITE_MESES) {
    mes++;
 
    const juros = arredondar(saldo * TAXA_JUROS);
    saldo = arredondar(saldo + juros);
 
    if (pagamentoMensal <= juros) {
      console.log(`Mês ${mes}: pagamento (R$ ${pagamentoMensal}) insuficiente para cobrir os juros (R$ ${juros}). Dívida não será quitada.`);
      break;
    }
 
    saldo = arredondar(saldo - pagamentoMensal);
    if (saldo < 0) {
      saldo = 0;
    }
 
    if (mes % 12 === 0 || saldo === 0) {
      console.log(`Mês ${mes}: saldo restante R$ ${saldo}`);
    }
  }
 
  if (saldo === 0) {
    console.log(`Dívida quitada em ${mes} mês(es).`);
  } else if (mes === LIMITE_MESES) {
    console.log(`Limite de ${LIMITE_MESES} meses atingido. Saldo restante: R$ ${saldo}`);
  }
}
 
console.log("--- Cenário viável ---");
simularPagamento(5000, 200);
 
console.log("--- Cenário com pagamento insuficiente ---");
simularPagamento(5000, 40);
